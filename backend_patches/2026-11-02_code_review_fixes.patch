+
+
+# ── B17：since 參數界限 ────────────────────────────────────────────────
+
+
+def test_b17_system_logs_since_out_of_range_is_422_not_500(client, api_auth, login):
+    resp = client.get(f"{BASE}/system-logs", params={"since": 10**20}, headers=login())
