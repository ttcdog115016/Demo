new file mode 100644
index 0000000..cc27aef
--- /dev/null
+++ b/app/governance/system_store.py
@@ -0,0 +1,256 @@
+"""系統資料（SQLite）：處理紀錄、系統維運日誌、系統設定、系統公告。
+
+★ TTC 2026-10-29：前端原本把這些資料存在使用者自己的瀏覽器（localStorage），
+換電腦或清快取就不見，管理員也看不到別人的紀錄；改為集中存在後端。
+
+與帳號資料庫（users.db）分開成 system.db：帳號與 token 必須在同一個交易內同生同滅，
+這裡的資料與帳號沒有那種綁定——刪帳號時處理紀錄仍保留，作為事後查核的依據。
+
+處理紀錄與公告的內容由前端組好（欄位很多且隨畫面演進），後端整筆以 JSON 存放，
+只把查詢會用到的欄位（帳號、時間）另外拉成欄位。
+"""
+
+import json
+import os
+import sqlite3
+import time
+from typing import Any
+
+from app.core.settings import get_data_dir
+
+# 每位使用者保留的處理紀錄筆數上限（新的在前），與前端原本的上限一致
+MAX_HISTORY_PER_USER = 200
+# 維運日誌保留筆數上限；超過時刪掉最舊的
+MAX_SYSTEM_LOGS = 5000
+MAX_ANNOUNCEMENTS = 50
+
+# 系統設定的預設值；只接受這裡列出的鍵
+DEFAULT_SETTINGS: dict[str, Any] = {
+    "session_timeout_minutes": 15,
+    "maintenance_mode": False,
+}
+
+
+def _now_ms() -> int:
+    return int(time.time() * 1000)
+
+
+class SystemStore:
+    """系統資料存取（SQLite）。"""
+
+    def __init__(self, db_path: str | None = None):
+        if db_path is None:
+            self.db_path = os.path.join(get_data_dir(), "system.db")
+        else:
+            self.db_path = db_path
+        os.makedirs(os.path.dirname(os.path.abspath(self.db_path)), exist_ok=True)
+        self._init_db()
+
+    def _connect(self) -> sqlite3.Connection:
+        conn = sqlite3.connect(self.db_path)
+        conn.row_factory = sqlite3.Row
+        return conn
+
+    def _init_db(self) -> None:
+        with self._connect() as conn:
+            conn.execute("PRAGMA journal_mode=WAL")
+            conn.executescript(
+                """
+                CREATE TABLE IF NOT EXISTS history (
+                    id TEXT PRIMARY KEY,
+                    username TEXT NOT NULL,
+                    created_at INTEGER NOT NULL,
+                    payload_json TEXT NOT NULL
+                );
+                CREATE INDEX IF NOT EXISTS idx_history_user ON history (username, created_at);
+                CREATE TABLE IF NOT EXISTS system_logs (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    ts INTEGER NOT NULL,
+                    level TEXT NOT NULL,
+                    event TEXT NOT NULL,
+                    source TEXT NOT NULL,
+                    username TEXT
+                );
+                CREATE INDEX IF NOT EXISTS idx_system_logs_ts ON system_logs (ts);
+                CREATE TABLE IF NOT EXISTS settings (
+                    key TEXT PRIMARY KEY,
+                    value_json TEXT NOT NULL,
+                    updated_at INTEGER NOT NULL,
+                    updated_by TEXT
+                );
+                CREATE TABLE IF NOT EXISTS announcements (
+                    id TEXT PRIMARY KEY,
+                    created_at INTEGER NOT NULL,
+                    payload_json TEXT NOT NULL
+                );
+                CREATE TABLE IF NOT EXISTS announcement_states (
+                    username TEXT NOT NULL,
+                    announcement_id TEXT NOT NULL,
+                    is_read INTEGER NOT NULL DEFAULT 0,
+                    dismissed INTEGER NOT NULL DEFAULT 0,
+                    PRIMARY KEY (username, announcement_id)
+                );
+                """
+            )
+
+    # ── 處理紀錄 ──────────────────────────────────────────────────────────
+    def add_history(self, username: str, record_id: str, payload: dict) -> None:
+        """新增（或以同一 id 覆寫）一筆處理紀錄；超過上限時刪掉該使用者最舊的。"""
+        created_at = payload.get("auditTimestamp")
+        if not isinstance(created_at, (int, float)):
+            created_at = _now_ms()
+        with self._connect() as conn:
+            conn.execute(
+                "INSERT OR REPLACE INTO history (id, username, created_at, payload_json) VALUES (?, ?, ?, ?)",
+                (record_id, username, int(created_at), json.dumps(payload, ensure_ascii=False)),
+            )
+            conn.execute(
+                """DELETE FROM history WHERE username = ? AND id NOT IN (
+                       SELECT id FROM history WHERE username = ? ORDER BY created_at DESC LIMIT ?)""",
+                (username, username, MAX_HISTORY_PER_USER),
+            )
+
+    def list_history(self, username: str | None = None) -> list[dict]:
+        """處理紀錄（新的在前）；username 為 None 時列出所有人的。"""
+        with self._connect() as conn:
+            if username is None:
+                rows = conn.execute("SELECT payload_json FROM history ORDER BY created_at DESC").fetchall()
+            else:
+                rows = conn.execute(
+                    "SELECT payload_json FROM history WHERE username = ? ORDER BY created_at DESC",
+                    (username,),
+                ).fetchall()
+        return [json.loads(row["payload_json"]) for row in rows]
+
+    # ── 系統維運日誌 ──────────────────────────────────────────────────────
+    def add_logs(self, entries: list[dict], username: str | None) -> int:
+        """批次寫入日誌；entries 每筆需有 level／event／source，ts 未給時用伺服器時間。"""
+        if not entries:
+            return 0
+        with self._connect() as conn:
+            conn.executemany(
+                "INSERT INTO system_logs (ts, level, event, source, username) VALUES (?, ?, ?, ?, ?)",
+                [
+                    (int(e.get("ts") or _now_ms()), e["level"], e["event"], e["source"], username)
+                    for e in entries
+                ],
+            )
+            conn.execute(
+                "DELETE FROM system_logs WHERE id NOT IN (SELECT id FROM system_logs ORDER BY id DESC LIMIT ?)",
+                (MAX_SYSTEM_LOGS,),
+            )
+        return len(entries)
+
+    def add_log(self, level: str, event: str, source: str, username: str | None = None) -> None:
+        self.add_logs([{"level": level, "event": event, "source": source}], username)
+
+    def list_logs(self, since_ms: int | None = None, limit: int = 1000) -> list[dict]:
+        """日誌（新的在前）。"""
+        with self._connect() as conn:
+            rows = conn.execute(
+                "SELECT id, ts, level, event, source FROM system_logs WHERE ts >= ? ORDER BY ts DESC, id DESC LIMIT ?",
+                (since_ms or 0, limit),
+            ).fetchall()
+        return [
+            {"id": str(r["id"]), "timestamp": r["ts"], "level": r["level"], "event": r["event"], "source": r["source"]}
+            for r in rows
+        ]
+
+    def clear_logs(self) -> None:
+        with self._connect() as conn:
+            conn.execute("DELETE FROM system_logs")
+
+    # ── 系統設定 ──────────────────────────────────────────────────────────
+    def get_settings(self) -> dict[str, Any]:
+        result = dict(DEFAULT_SETTINGS)
+        with self._connect() as conn:
+            for row in conn.execute("SELECT key, value_json FROM settings").fetchall():
+                if row["key"] in DEFAULT_SETTINGS:
+                    result[row["key"]] = json.loads(row["value_json"])
+        return result
+
+    def update_settings(self, changes: dict[str, Any], updated_by: str) -> dict[str, Any]:
+        with self._connect() as conn:
+            for key, value in changes.items():
+                conn.execute(
+                    "INSERT OR REPLACE INTO settings (key, value_json, updated_at, updated_by) VALUES (?, ?, ?, ?)",
+                    (key, json.dumps(value), _now_ms(), updated_by),
+                )
+        return self.get_settings()
+
+    def is_maintenance_mode(self) -> bool:
+        return bool(self.get_settings().get("maintenance_mode"))
+
+    # ── 系統公告 ──────────────────────────────────────────────────────────
+    def list_announcements(self) -> list[dict]:
+        with self._connect() as conn:
+            rows = conn.execute("SELECT payload_json FROM announcements ORDER BY created_at DESC").fetchall()
+        return [json.loads(r["payload_json"]) for r in rows]
+
+    def get_announcement(self, announcement_id: str) -> dict | None:
+        with self._connect() as conn:
+            row = conn.execute(
+                "SELECT payload_json FROM announcements WHERE id = ?", (announcement_id,)
+            ).fetchone()
+        return json.loads(row["payload_json"]) if row else None
+
+    def save_announcement(self, payload: dict) -> dict:
+        """新增或覆寫一則公告（payload 需含 id、createdAt）；超過上限時刪掉最舊的。"""
+        with self._connect() as conn:
+            conn.execute(
+                "INSERT OR REPLACE INTO announcements (id, created_at, payload_json) VALUES (?, ?, ?)",
+                (payload["id"], int(payload["createdAt"]), json.dumps(payload, ensure_ascii=False)),
+            )
+            conn.execute(
+                "DELETE FROM announcements WHERE id NOT IN (SELECT id FROM announcements ORDER BY created_at DESC LIMIT ?)",
+                (MAX_ANNOUNCEMENTS,),
+            )
+            conn.execute(
+                "DELETE FROM announcement_states WHERE announcement_id NOT IN (SELECT id FROM announcements)"
+            )
+        return payload
+
+    def delete_announcement(self, announcement_id: str) -> bool:
+        with self._connect() as conn:
+            deleted = conn.execute("DELETE FROM announcements WHERE id = ?", (announcement_id,)).rowcount
+            conn.execute("DELETE FROM announcement_states WHERE announcement_id = ?", (announcement_id,))
+        return deleted > 0
+
+    def reset_announcement_states(self, announcement_id: str) -> None:
+        """清除所有人對這則公告的已讀／已關閉狀態（修改後重新提醒）。"""
+        with self._connect() as conn:
+            conn.execute("DELETE FROM announcement_states WHERE announcement_id = ?", (announcement_id,))
+
+    def mark_announcements(self, username: str, announcement_ids: list[str], field: str) -> None:
+        """把公告標成已讀（field='is_read'）或已關閉橫幅（field='dismissed'）。"""
+        if field not in ("is_read", "dismissed"):
+            raise ValueError(field)
+        with self._connect() as conn:
+            for announcement_id in announcement_ids:
+                conn.execute(
+                    f"""INSERT INTO announcement_states (username, announcement_id, {field}) VALUES (?, ?, 1)
+                        ON CONFLICT (username, announcement_id) DO UPDATE SET {field} = 1""",
+                    (username, announcement_id),
+                )
+
+    def get_announcement_states(self, username: str) -> dict[str, list[str]]:
+        with self._connect() as conn:
+            rows = conn.execute(
+                "SELECT announcement_id, is_read, dismissed FROM announcement_states WHERE username = ?",
+                (username,),
+            ).fetchall()
+        return {
+            "read_ids": [r["announcement_id"] for r in rows if r["is_read"]],
+            "dismissed_ids": [r["announcement_id"] for r in rows if r["dismissed"]],
+        }
+
+
+_system_store: SystemStore | None = None
+
+
+def get_system_store() -> SystemStore:
+    """全專案共用的系統資料存取；延後建立，理由同 auth.get_auth_manager()。"""
+    global _system_store
+    if _system_store is None:
+        _system_store = SystemStore()
+    return _system_store
