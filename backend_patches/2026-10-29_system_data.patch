+"""
+API - 系統資料端點（★ TTC 2026-10-29）整合測試
+涵蓋：處理紀錄、系統維運日誌、系統設定與維護模式、系統公告。
+"""
+import pytest
+
+from app.governance.system_store import SystemStore
+
+BASE = "/api/v1"
+
+
+@pytest.fixture(autouse=True)
+def system_store(monkeypatch, tmp_path):
+    """系統資料庫落在測試專屬暫存目錄，不動到部署環境的 system.db"""
+    store = SystemStore(db_path=str(tmp_path / "system.db"))
+    monkeypatch.setattr("app.governance.system_store._system_store", store)
+    return store
+
+
+# ──────────────────────────────────────────────────────────────
+# 處理紀錄
+# ──────────────────────────────────────────────────────────────
+def test_history_is_per_user(client, api_auth, login):
+    user_headers = login("user", "user123")
+    resp = client.post(
+        f"{BASE}/history",
+        json={"id": "r1", "fileName": "a.csv", "auditTimestamp": 1000, "operator": "someone-else"},
+        headers=user_headers,
+    )
+    assert resp.status_code == 201
+    # 操作者一律以登入帳號為準，不採信前端送來的值
+    assert resp.json()["operator"] == "user"
+
+    client.post(f"{BASE}/history", json={"id": "r2", "auditTimestamp": 2000}, headers=login())
+
+    records = client.get(f"{BASE}/history", headers=user_headers).json()["records"]
+    assert [r["id"] for r in records] == ["r1"]
+    assert records[0]["fileName"] == "a.csv"
+
+
+def test_history_all_is_admin_only(client, api_auth, login):
+    client.post(f"{BASE}/history", json={"id": "r1", "auditTimestamp": 1000}, headers=login("user", "user123"))
+    client.post(f"{BASE}/history", json={"id": "r2", "auditTimestamp": 2000}, headers=login())
+
+    assert client.get(f"{BASE}/history?all=1", headers=login("user", "user123")).status_code == 403
+    records = client.get(f"{BASE}/history?all=1", headers=login()).json()["records"]
+    assert [r["id"] for r in records] == ["r2", "r1"]
+
+
+def test_history_requires_login(client, api_auth):
+    assert client.get(f"{BASE}/history").status_code == 401
+
+
+# ──────────────────────────────────────────────────────────────
+# 系統維運日誌
+# ──────────────────────────────────────────────────────────────
+def test_logs_write_by_user_read_by_admin(client, api_auth, login):
+    resp = client.post(
+        f"{BASE}/system-logs",
+        json={"entries": [{"level": "INFO", "event": "後端 API 呼叫成功", "source": "POST /api/v1/dp"}]},
+        headers=login("user", "user123"),
+    )
+    assert resp.status_code == 201
+
+    assert client.get(f"{BASE}/system-logs", headers=login("user", "user123")).status_code == 403
+    logs = client.get(f"{BASE}/system-logs", headers=login()).json()["logs"]
+    assert any(log["event"] == "後端 API 呼叫成功" for log in logs)
+
+    assert client.delete(f"{BASE}/system-logs", headers=login()).status_code == 200
+    assert client.get(f"{BASE}/system-logs", headers=login()).json()["logs"] == []
+
+
+def test_login_failure_is_logged_by_backend(client, api_auth, system_store):
+    client.post(f"{BASE}/auth/login", json={"username": "user", "password": "wrong"})
+    events = [log["event"] for log in system_store.list_logs()]
+    assert "登入失敗（帳號或密碼錯誤）" in events
+
+
+# ──────────────────────────────────────────────────────────────
+# 系統設定與維護模式
+# ──────────────────────────────────────────────────────────────
+def test_settings_readable_without_login(client, api_auth):
+    body = client.get(f"{BASE}/settings").json()
+    assert body == {"session_timeout_minutes": 15, "maintenance_mode": False}
+
+
+def test_settings_update_admin_only(client, api_auth, login):
+    assert client.put(
+        f"{BASE}/settings", json={"session_timeout_minutes": 30}, headers=login("user", "user123")
+    ).status_code == 403
+
+    body = client.put(f"{BASE}/settings", json={"session_timeout_minutes": 30}, headers=login()).json()
+    assert body["session_timeout_minutes"] == 30
+    assert client.get(f"{BASE}/settings").json()["session_timeout_minutes"] == 30
+
+    assert client.put(
+        f"{BASE}/settings", json={"session_timeout_minutes": 0}, headers=login()
+    ).status_code == 422
+
+
+def test_maintenance_blocks_user_login_and_refresh(client, api_auth, login):
+    user_tokens = client.post(
+        f"{BASE}/auth/login", json={"username": "user", "password": "user123"}
+    ).json()
+    client.put(f"{BASE}/settings", json={"maintenance_mode": True}, headers=login())
+
+    resp = client.post(f"{BASE}/auth/login", json={"username": "user", "password": "user123"})
+    assert resp.status_code == 503
+    assert resp.json()["error_code"] == "ERR_MAINTENANCE"
+
+    resp = client.post(f"{BASE}/auth/refresh", json={"refresh_token": user_tokens["refresh_token"]})
+    assert resp.status_code == 503
+
+    # admin 仍可登入
+    assert client.post(
+        f"{BASE}/auth/login", json={"username": "admin", "password": "admin123"}
+    ).status_code == 200
+
+
+# ──────────────────────────────────────────────────────────────
+# 系統公告
+# ──────────────────────────────────────────────────────────────
+def test_announcement_lifecycle(client, api_auth, login):
+    admin_headers = login()
+    user_headers = login("user", "user123")
+
+    assert client.post(
+        f"{BASE}/announcements", json={"title": "t", "content": "c"}, headers=user_headers
+    ).status_code == 403
+
+    created = client.post(
+        f"{BASE}/announcements",
+        json={"title": "停機通知", "content": "今晚維護", "level": "important"},
+        headers=admin_headers,
+    ).json()
+    announcement_id = created["id"]
+    assert created["createdBy"] == "admin"
+
+    body = client.get(f"{BASE}/announcements", headers=user_headers).json()
+    assert [a["id"] for a in body["announcements"]] == [announcement_id]
+    assert body["read_ids"] == [] and body["dismissed_ids"] == []
+
+    client.post(f"{BASE}/announcements/read", json={"ids": [announcement_id]}, headers=user_headers)
+    client.post(f"{BASE}/announcements/dismiss", json={"ids": [announcement_id]}, headers=user_headers)
+    body = client.get(f"{BASE}/announcements", headers=user_headers).json()
+    assert body["read_ids"] == [announcement_id] and body["dismissed_ids"] == [announcement_id]
+
+    # 修改並重新提醒：已讀狀態清除
+    updated = client.patch(
+        f"{BASE}/announcements/{announcement_id}",
+        json={"content": "改為明晚", "renotify": True},
+        headers=admin_headers,
+    ).json()
+    assert updated["content"] == "改為明晚" and updated["title"] == "停機通知"
+    body = client.get(f"{BASE}/announcements", headers=user_headers).json()
+    assert body["read_ids"] == []
+
+    ended = client.post(f"{BASE}/announcements/{announcement_id}/end", headers=admin_headers).json()
+    assert ended["expiresAt"] is not None
+
+    assert client.delete(f"{BASE}/announcements/{announcement_id}", headers=admin_headers).status_code == 200
+    assert client.get(f"{BASE}/announcements", headers=user_headers).json()["announcements"] == []
+    assert client.delete(f"{BASE}/announcements/{announcement_id}", headers=admin_headers).status_code == 404
