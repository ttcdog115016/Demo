new file mode 100644
index 0000000..8bfa2d3
--- /dev/null
+++ b/app/api/system_router.py
@@ -0,0 +1,190 @@
+"""系統資料端點（★ TTC 2026-10-29）：處理紀錄、系統維運日誌、系統設定、系統公告。
+
+資料存放見 governance/system_store。權限：
+    處理紀錄  登入者讀寫自己的；admin 可列出所有人的（?all=1）
+    維運日誌  登入者可寫入；讀取與清除限 admin
+    系統設定  免登入可讀（登入頁要知道是否維護中）；修改限 admin
+    系統公告  登入者可讀、可標記已讀／關閉橫幅；發布、修改、刪除限 admin
+
+維運日誌的事件文字由前端產生（設定變更、公告、API 呼叫結果等，前端原本就有這些紀錄點），
+後端只自行記錄前端無法代寫的事件：登入失敗、帳號鎖定、維護模式擋下登入（見 auth_router）。
+"""
+
+import time
+import uuid
+from typing import Literal
+
+from fastapi import APIRouter, Depends
+from pydantic import BaseModel, Field
+
+from app.api.auth_router import get_current_user, require_role
+from app.core.errors import PetsError
+from app.governance.system_store import get_system_store
+
+router = APIRouter(tags=["系統資料"])
+
+
+def _now_ms() -> int:
+    return int(time.time() * 1000)
+
+
+# ── 處理紀錄 ────────────────────────────────────────────────────────────────
+@router.get("/history")
+def list_history(all: bool = False, user: dict = Depends(get_current_user)):
+    """處理紀錄（新的在前）。一般使用者只看得到自己的；admin 帶 all=1 列出所有人的。"""
+    if all and user["role"] != "admin":
+        raise PetsError("ERR_FORBIDDEN", "權限不足，列出所有人的紀錄僅限 admin。")
+    records = get_system_store().list_history(None if all else user["username"])
+    return {"records": records, "total": len(records)}
+
+
+@router.post("/history", status_code=201)
+def add_history(record: dict, user: dict = Depends(get_current_user)):
+    """新增一筆自己的處理紀錄（內容由前端組好，整筆保存）。操作者一律以登入帳號為準。"""
+    record_id = record.get("id")
+    if not isinstance(record_id, str) or not record_id:
+        record_id = str(uuid.uuid4())
+    payload = {**record, "id": record_id, "operator": user["username"]}
+    get_system_store().add_history(user["username"], record_id, payload)
+    return payload
+
+
+# ── 系統維運日誌 ────────────────────────────────────────────────────────────
+class LogEntry(BaseModel):
+    level: Literal["INFO", "WARN", "ERROR"]
+    event: str = Field(..., min_length=1, max_length=500)
+    source: str = Field("System", max_length=200)
+    ts: int | None = None
+
+
+class LogBatch(BaseModel):
+    entries: list[LogEntry] = Field(..., max_length=200)
+
+
+@router.post("/system-logs", status_code=201)
+def add_system_logs(batch: LogBatch, user: dict = Depends(get_current_user)):
+    """批次寫入前端發生的事件（API 呼叫結果、設定變更等）。"""
+    count = get_system_store().add_logs([e.model_dump() for e in batch.entries], user["username"])
+    return {"saved": count}
+
+
+@router.get("/system-logs")
+def list_system_logs(
+    since: int | None = None,
+    limit: int = 1000,
+    _: dict = Depends(require_role("admin")),
+):
+    """日誌（新的在前）；since 為 epoch 毫秒。"""
+    logs = get_system_store().list_logs(since, max(1, min(limit, 5000)))
+    return {"logs": logs, "total": len(logs)}
+
+
+@router.delete("/system-logs")
+def clear_system_logs(_: dict = Depends(require_role("admin"))):
+    get_system_store().clear_logs()
+    return {"message": "日誌已清除。"}
+
+
+# ── 系統設定 ────────────────────────────────────────────────────────────────
+class SettingsUpdate(BaseModel):
+    session_timeout_minutes: int | None = Field(None, ge=1, le=1440)
+    maintenance_mode: bool | None = None
+
+
+@router.get("/settings")
+def get_settings():
+    """系統設定（免登入：登入頁需要知道是否維護中）。"""
+    return get_system_store().get_settings()
+
+
+@router.put("/settings")
+def update_settings(req: SettingsUpdate, user: dict = Depends(require_role("admin"))):
+    return get_system_store().update_settings(req.model_dump(exclude_none=True), user["username"])
+
+
+# ── 系統公告 ────────────────────────────────────────────────────────────────
+class AnnouncementBody(BaseModel):
+    title: str = Field(..., min_length=1, max_length=200)
+    content: str = Field(..., max_length=5000)
+    level: Literal["normal", "important"] = "normal"
+    audience: Literal["all", "data_owner", "admin"] = "all"
+    icon: str | None = Field(None, max_length=16)
+    expiresAt: int | None = None
+
+
+class AnnouncementPatch(BaseModel):
+    title: str | None = Field(None, min_length=1, max_length=200)
+    content: str | None = Field(None, max_length=5000)
+    level: Literal["normal", "important"] | None = None
+    audience: Literal["all", "data_owner", "admin"] | None = None
+    icon: str | None = Field(None, max_length=16)
+    expiresAt: int | None = None
+    renotify: bool = False
+
+
+class AnnouncementIds(BaseModel):
+    ids: list[str] = Field(..., max_length=200)
+
+
+def _require_announcement(announcement_id: str) -> dict:
+    item = get_system_store().get_announcement(announcement_id)
+    if item is None:
+        raise PetsError("ERR_NOT_FOUND", "找不到這則公告。")
+    return item
+
+
+@router.get("/announcements")
+def list_announcements(user: dict = Depends(get_current_user)):
+    """全部公告（新的在前）與目前帳號的已讀／已關閉橫幅狀態；依對象與期限的篩選由前端做。"""
+    store = get_system_store()
+    return {"announcements": store.list_announcements(), **store.get_announcement_states(user["username"])}
+
+
+@router.post("/announcements", status_code=201)
+def publish_announcement(req: AnnouncementBody, user: dict = Depends(require_role("admin"))):
+    payload = {**req.model_dump(), "id": str(uuid.uuid4()), "createdAt": _now_ms(), "createdBy": user["username"]}
+    get_system_store().save_announcement(payload)
+    return payload
+
+
+@router.patch("/announcements/{announcement_id}")
+def update_announcement(announcement_id: str, req: AnnouncementPatch, user: dict = Depends(require_role("admin"))):
+    """修改公告；renotify=true 時清除所有人的已讀／已關閉狀態，讓修改後內容重新提醒。"""
+    item = _require_announcement(announcement_id)
+    # expiresAt 可明確設為 null（改為不限期），故以「有沒有送這個欄位」判斷
+    changes = req.model_dump(exclude_unset=True)
+    renotify = changes.pop("renotify", False)
+    payload = {**item, **changes, "updatedAt": _now_ms()}
+    store = get_system_store()
+    store.save_announcement(payload)
+    if renotify:
+        store.reset_announcement_states(announcement_id)
+    return payload
+
+
+@router.post("/announcements/{announcement_id}/end")
+def end_announcement(announcement_id: str, _: dict = Depends(require_role("admin"))):
+    """立即結束顯示：把顯示期限設為現在，列表保留並標示已過期。"""
+    item = _require_announcement(announcement_id)
+    payload = {**item, "expiresAt": _now_ms()}
+    get_system_store().save_announcement(payload)
+    return payload
+
+
+@router.delete("/announcements/{announcement_id}")
+def delete_announcement(announcement_id: str, _: dict = Depends(require_role("admin"))):
+    _require_announcement(announcement_id)
+    get_system_store().delete_announcement(announcement_id)
+    return {"message": "公告已刪除。"}
+
+
+@router.post("/announcements/read")
+def mark_announcements_read(req: AnnouncementIds, user: dict = Depends(get_current_user)):
+    get_system_store().mark_announcements(user["username"], req.ids, "is_read")
+    return {"message": "ok"}
+
+
+@router.post("/announcements/dismiss")
+def dismiss_announcement_banners(req: AnnouncementIds, user: dict = Depends(get_current_user)):
+    get_system_store().mark_announcements(user["username"], req.ids, "dismissed")
+    return {"message": "ok"}
