+    # ── 介面偏好（★ TTC 2026-10-29：依帳號記住外觀主題、語系、字體大小） ──
+    def get_preferences(self, username: str) -> dict[str, Any]:
+        with self._connect() as conn:
+            row = conn.execute("SELECT prefs_json FROM user_preferences WHERE username = ?", (username,)).fetchone()
+        return json.loads(row["prefs_json"]) if row else {}
+
+    def save_preferences(self, username: str, changes: dict[str, Any]) -> dict[str, Any]:
+        """只更新有送的欄位，回傳更新後的完整偏好。"""
+        merged = {**self.get_preferences(username), **changes}
+        with self._connect() as conn:
+            conn.execute(
+                "INSERT OR REPLACE INTO user_preferences (username, prefs_json, updated_at) VALUES (?, ?, ?)",
+                (username, json.dumps(merged, ensure_ascii=False), _now_ms()),
+            )
+        return merged
+
