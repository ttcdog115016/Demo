# 內網 HTTPS 的反向代理設定（搭配 docker-compose.https.yml，由 compose 掛載，一般不需要修改）
#
# - 憑證由 Caddy 內建的私有 CA 簽發（tls internal）：不需要對外網路，也不申請 Let's Encrypt。
#   各台使用者電腦要「信任這個私有 CA 的根憑證」，瀏覽器才不會顯示憑證警告（作法見說明文件「內網 HTTPS」）。
# - 站台位址取自 .env 的 OPEN_PETS_ALLOWED_HOSTS（內網 IP 或主機名稱，逗號分隔），與應用程式的主機名稱檢查同一份清單；
#   docker-compose.https.yml 啟動時會把逗號換成空格（Caddy 的位址清單用空格分隔），放進 OPEN_PETS_SITE_ADDRESSES。
{
	local_certs
	# 不要把根憑證裝進容器自己的信任庫（容器是唯讀的，只會產生錯誤訊息）；使用者電腦要信任的是匯出的根憑證
	skip_install_trust
	# 網址是 IP 時瀏覽器不送 SNI，要指定沒有 SNI 時使用哪一張憑證（docker-compose.https.yml 啟動時挑第一個 IP）
	default_sni {$OPEN_PETS_DEFAULT_SNI}
}

{$OPEN_PETS_SITE_ADDRESSES} {
	tls internal

	# 與應用程式的上傳上限一致（OPEN_PETS_MAX_UPLOAD_MB，預設 1024）
	request_body {
		max_size 1024MB
	}
	header Strict-Transport-Security "max-age=31536000"

	# Host 標頭原樣轉送；大檔案的處理時間可能很長，逾時設長一點
	reverse_proxy open-pets:8080 {
		transport http {
			response_header_timeout 15m
		}
	}
}
