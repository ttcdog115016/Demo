{
  "version": "1.2.0",
  "dataset": "input_1m.csv",
  "input_format": "csv",
  "differential_privacy": {
    "enabled": true,
    "accumulated_epsilon": 0.0,
    "accumulated_delta": 0.0,
    "default_delta": 1e-05,
    "column_budgets": {
      "年齡": {
        "type": "continuous",
        "epsilon_budget": 5.0,
        "delta_budget": 0.0,
        "sensitivity": 71.0,
        "minimum_unit": 1,
        "clipping_bounds": [0, 120],
        "out_of_bounds_strategy": "clamp"
      },
      "薪資": {
        "type": "continuous",
        "epsilon_budget": 5.0,
        "delta_budget": 1e-05,
        "sensitivity": 125000.0,
        "minimum_unit": 1000,
        "clipping_bounds": [0, 300000],
        "out_of_bounds_strategy": "fold"
      },
      "就醫次數": {
        "type": "continuous",
        "epsilon_budget": 4.0,
        "sensitivity": 19.0,
        "minimum_unit": 1,
        "clipping_bounds": [0, 20],
        "out_of_bounds_strategy": "wrap"
      },
      "地區": {
        "type": "categorical",
        "epsilon_budget": 1.0
      },
      "職業": {
        "type": "categorical",
        "epsilon_budget": 1.0
      },
      "生日": {
        "type": "datetime",
        "epsilon_budget": 1.0,
        "delta_budget": 0.0,
        "sensitivity": 365.0,
        "noise_unit": "day",
        "noise_step": 7,
        "time_clipping_bounds": ["1930-01-01", "2026-12-31"],
        "time_out_of_bounds_strategy": "clamp"
      }
    }
  }
}
