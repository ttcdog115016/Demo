{
  "version": "1.2.0",
  "dataset": "input_test.csv",
  "input_format": "csv",
  "k_anonymity": {
    "enabled": true,
    "k": 5,
    "l": 2,
    "t": 0.7,
    "suppression_limit_percent": 20,
    "limit_exceeded_action": "allow_with_warning",
    "suppression_method": "row_suppression",
    "columns": {
      "姓名": {
        "role": "identifier",
        "type": "string",
        "strategy": "remove"
      },
      "身分證號": {
        "role": "identifier",
        "type": "string",
        "strategy": "remove"
      },
      "年齡": {
        "role": "quasi_identifier",
        "type": "numeric"
      },
      "地區": {
        "role": "quasi_identifier",
        "type": "categorical"
      },
      "生日": {
        "role": "quasi_identifier",
        "type": "temporal"
      },
      "疾病": {
        "role": "sensitive",
        "type": "categorical"
      },
      "薪資": {
        "role": "quasi_identifier",
        "type": "numeric"
      },
      "職業": {
        "role": "quasi_identifier",
        "type": "categorical"
      },
      "婚姻狀況": {
        "role": "non_sensitive",
        "type": "categorical"
      },
      "就醫次數": {
        "role": "quasi_identifier",
        "type": "numeric"
      }
    },
    "generalization_hierarchies": {
      "年齡": {
        "bins": [
          {
            "min": null,
            "max": 18,
            "label": "未成年"
          },
          {
            "min": 18,
            "max": 40,
            "label": "青年"
          },
          {
            "min": 40,
            "max": 65,
            "label": "中年"
          },
          {
            "min": 65,
            "max": null,
            "label": "銀髮族"
          }
        ]
      },
      "生日": {
        "levels": [
          "second",
          "minute",
          "hour",
          "day",
          "month",
          "year"
        ]
      },
      "薪資": {
        "rounding": 35000
      },
      "就醫次數": {
        "rounding": 2
      }
    },
    "generalization_matrices": {
      "地區": {
        "mapping": {
          "大安區": [
            "大安區",
            "臺北市",
            "北部",
            "全國"
          ],
          "中正區": [
            "中正區",
            "臺北市",
            "北部",
            "全國"
          ],
          "板橋區": [
            "板橋區",
            "新北市",
            "北部",
            "全國"
          ],
          "苓雅區": [
            "苓雅區",
            "高雄市",
            "南部",
            "全國"
          ]
        }
      },
      "職業": {
        "mapping": {
          "工程師": [
            "工程師",
            "專業技術",
            "在職",
            "全體"
          ],
          "教師": [
            "教師",
            "專業技術",
            "在職",
            "全體"
          ],
          "醫師": [
            "醫師",
            "專業技術",
            "在職",
            "全體"
          ],
          "公務員": [
            "公務員",
            "一般受僱",
            "在職",
            "全體"
          ],
          "服務業": [
            "服務業",
            "一般受僱",
            "在職",
            "全體"
          ],
          "自由業": [
            "自由業",
            "一般受僱",
            "在職",
            "全體"
          ],
          "學生": [
            "學生",
            "非在職",
            "非在職",
            "全體"
          ],
          "退休": [
            "退休",
            "非在職",
            "非在職",
            "全體"
          ]
        }
      }
    },
    "qi_generalization_levels": {
      "地區": 2,
      "生日": 3,
      "職業": 3
    }
  }
}