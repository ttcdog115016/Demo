# ── Open-PETs 部署層級設定範本 ──────────────────────────────────
# 複製為 .env 後填入實際值；.env 已列入 .gitignore，切勿提交真實秘密。

# 伺服器端預設雜湊鹽值：假名化與資料前處理的雜湊功能未自帶鹽時使用。
# 未設定時不擋，改為對值本身做雜湊（無鹽雜湊可被字典反查，要不要加鹽由部署者決定）。
# 請以高強度隨機字串替換，例如執行：
#   python -c "import secrets; print(secrets.token_hex(32))"
OPEN_PETS_DEFAULT_SALT=

# 執行期資料目錄：使用者資料庫（users.db）與審計日誌（audit.jsonl）的存放位置。
# 未設定時退到「執行時工作目錄」下的 data/，並於啟動時告知實際落點。
# 唯讀安裝、容器部署或多實例共用同一份程式碼時務必指定可寫入的獨立目錄，
# 例如：OPEN_PETS_DATA_DIR=/var/lib/open-pets
OPEN_PETS_DATA_DIR=

# 審計日誌鏈式防篡改的系統主金鑰（HMAC key）。
# 未設定時審計日誌僅記錄、不簽章（不提供防篡改保護，系統照常運作），
# 正式部署務必以高強度隨機字串設定：
#   python -c "import secrets; print(secrets.token_hex(32))"
OPEN_PETS_SYSTEM_MASTER_KEY=

# 登入功能（/auth 與 /users 兩組端點）簽發 access token 用的簽章金鑰。
# 未設定時這兩組端點一律回 503「登入功能尚未啟用，請聯繫系統管理員。」，
# 處理端點（去識別化、差分隱私、風險評估、資料前處理、報告）須登入，同樣回 503；
# 服務啟動時會在系統日誌寫明缺的是本項設定。
# 要啟用登入功能請以高強度隨機字串設定：
#   python -c "import secrets; print(secrets.token_hex(32))"
# ★更換此金鑰會使既已簽發的 access token 全數失效，所有人須重新登入。
OPEN_PETS_JWT_SECRET=

# 單次請求允許的最大上傳大小（MB）。超過即回 413，並在讀取請求主體之前就擋下，
# 避免超大檔案先把記憶體吃滿才失敗。未設定時採內建預設 1024（實測 500 萬筆
# × 10 欄的 CSV 約 430~540 MB）。設為 0 代表明確要求不設限。
OPEN_PETS_MAX_UPLOAD_MB=

# 允許跨網域呼叫 API 的來源（逗號分隔，例如 https://demo.example.com）。
# 未設定＝不開放跨網域：單機版、經 Vite／nginx 代理的部署都是同源，不需要設定。
OPEN_PETS_CORS_ORIGINS=

# 允許的 Host 標頭（逗號分隔），防止 DNS rebinding；未設定＝不限制。單機版啟動時自動設為 127.0.0.1,localhost。
OPEN_PETS_ALLOWED_HOSTS=

# API 以 source／*_source 欄位讀取「伺服器本機」資料檔或 sqlite:/// 時允許的目錄，
# 多個目錄以作業系統路徑分隔字元分隔（Linux「:」、Windows「;」）。
# 未設定即停用，處理端點只收上傳檔案；OPEN_PETS_DATA_DIR（帳號、系統資料庫、稽核日誌）一律不可讀。
OPEN_PETS_ALLOWED_SOURCE_DIRS=

# ── 系統日誌 ────────────────────────────────────────────────────
# 以下三項只作用於系統日誌（程式運行的警告與錯誤），與審計日誌無關：
# 審計日誌的落點由 OPEN_PETS_DATA_DIR 決定，且不會因日誌設定而關閉或改寫。

# 系統日誌檔的存放路徑。未設定時僅輸出至畫面、不寫檔（唯讀環境亦可正常啟動）。
# 指定後檔案會自動輪替（單檔 10 MB、保留 5 份），內容為每行一筆 JSON。
# 例如：OPEN_PETS_LOG_FILE=/var/log/open-pets/app.jsonl
OPEN_PETS_LOG_FILE=

# 系統日誌等級（DEBUG／INFO／WARNING／ERROR）。未設定時採內建預設 WARNING。
# ★預設等級下 INFO 與 DEBUG 的訊息不會出現，要看流程細節請設為 INFO 或 DEBUG。
OPEN_PETS_LOG_LEVEL=

# 自備的 logging 設定檔路徑（JSON，格式為 Python logging 的 dictConfig）。
# 設定後整份取代內建設定：輸出格式（JSON 或純文字）、輸出位置（畫面／檔案／
# syslog）、各模組的等級皆由該檔決定，無須改動程式碼。此時上面兩項不再適用。
# 檔案讀不到或內容無法解讀時，退回內建設定並於啟動時告知。
OPEN_PETS_LOG_CONFIG=
